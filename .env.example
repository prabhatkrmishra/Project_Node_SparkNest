# =============================================================================
# SparkNest — Environment Variables
# =============================================================================
# Copy this file to .env (root) and server/.env / client/.env as needed:
#   cp .env.example .env
#   cp .env.example server/.env   # server reads server/.env via dotenv
# Docker Compose reads .env from the project root.
# Never commit real secrets — .env is gitignored.
# =============================================================================

# --- Server: Host & Port -----------------------------------------------------
# What: Address the Express server binds to.
# Used by: server/config/env.js → server/server.js (app.listen)
SERVER_HOSTNAME=localhost
SERVER_PORT=3000

# --- Database: Primary (recommended) -----------------------------------------
# What: Full Postgres connection string. Takes precedence over PG_* below.
# Used by: server/db/db.js (pg Pool), server/db/migrate.js (Flyway JDBC)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#   - Local dev:  postgresql://pkm774:pass@localhost:5432/sparknest
#   - Managed DB (Neon/Supabase/Render): add ?sslmode=require
# Required: Yes — either DATABASE_URL or PG_* must be set.
DATABASE_URL=postgresql://pkm774:pass@localhost:5432/sparknest

# --- Database: Fallback (used only if DATABASE_URL is empty) ----------------
# What: Individual Postgres credentials. Ignored when DATABASE_URL is set.
# Used by: server/db/db.js, server/db/migrate.js (fallback path)
# PGSSLMODE=require enables SSL (e.g. for managed DBs without DATABASE_URL)
# PG_USER=pkm774
# PG_HOST=localhost
# PG_DATABASE=sparknest
# PG_PASSWORD=pass
# PG_PORT=5432
# PGSSLMODE=require

# --- Session & Cookies -------------------------------------------------------
# What: Secret for signing express-session cookies. Must be >=32 chars.
# Used by: server/app.js (express-session), server/config/env.js (Zod validation)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_32_chars_minimum_secret_here

# What: Cookie flags. Set SECURE_COOKIE=true in production (HTTPS only).
# Used by: server/app.js (session cookie options)
SECURE_COOKIE=false
HTTP_ONLY=true
SAME_SITE=lax

# --- CORS & Addresses --------------------------------------------------------
# What: Allowed frontend origin (CORS) and backend self-URL.
# Used by: server/app.js (CORS allowlist), emails/OAuth callbacks
FRONTEND_ADDRESS=http://localhost:5143
BACKEND_ADDRESS=http://localhost:3000

# --- Auth: Password Hashing --------------------------------------------------
# What: bcrypt salt rounds (4-15, higher = slower but stronger).
# Used by: server/services/authService.js (password hashing)
PASSWORD_SALTROUNDS=10

# --- Auth: Google OAuth (optional) -------------------------------------------
# What: Google OAuth 2.0 credentials. Leave empty to disable Google login.
# Used by: server/config/passport.js (GoogleStrategy)
# Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/home

# --- Email: Password Reset & Contact (optional) ------------------------------
# What: SMTP credentials for sending reset-password and contact emails.
# Used by: server/services/emailService.js (nodemailer)
# For Gmail: use an App Password, not your main password.
# SERVICE_EMAIL_USER=
# SERVICE_EMAIL_PASS=

# --- Storage -----------------------------------------------------------------
# What: Root directory for uploaded files (images, attachments).
# Used by: server/services/storageService.js, server/config/env.js
# In Docker: set to /data (mounted volume appdata)
DATA_ROOT=./data

# --- Logging & Env -----------------------------------------------------------
# What: Runtime environment and log verbosity.
# Used by: server/config/env.js, server/config/logger.js (pino)
NODE_ENV=development
# LOG_LEVEL=info

# --- Client: Frontend (client/.env) -----------------------------------------
# What: Backend API URL the Vite frontend calls.
# Used by: client/src/config/env.ts, client/vite.config.js (dev proxy)
# Must be set in client/.env as VITE_API_URL (Vite exposes only VITE_* vars)
VITE_API_URL=http://localhost:3000
# VITE_APP_NAME=SparkNest

# --- Production: HTTPS + Cloudflare DNS-01 (docker-compose.prod.yml) -----------
# What: Domain and email for Let's Encrypt via Cloudflare DNS-01 (443 only).
# Used by: docker-compose.prod.yml (nginx template + certbot/dns-cloudflare)
# No port 80 needed — DNS-01 validates via Cloudflare API.
# Setup: cp cloudflare.ini.example cloudflare.ini, put token, chmod 600
# Token: https://dash.cloudflare.com/profile/api-tokens (Zone:Read, DNS:Edit)
# DOMAIN=yourdomain.com
# CERTBOT_EMAIL=you@yourdomain.com
# In prod .env set also:
#   FRONTEND_ADDRESS=https://yourdomain.com
#   BACKEND_ADDRESS=https://yourdomain.com
#   SECURE_COOKIE=true
#   NODE_ENV=production
