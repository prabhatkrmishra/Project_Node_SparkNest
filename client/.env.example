# =============================================================================
# SparkNest Client — Environment Variables
# =============================================================================
# Copy to client/.env:
#   cp client/.env.example client/.env
# Vite only exposes VITE_* vars to the browser.
# Used by: client/src/config/env.ts, client/vite.config.js (dev proxy)
# =============================================================================

# Backend API URL the frontend calls.
# Used by: client/src/config/env.ts (apiUrl), client/vite.config.js (proxy)
VITE_API_URL=http://localhost:3000

# App display name (optional, defaults to SparkNest).
# Used by: client/src/config/env.ts (appName)
# VITE_APP_NAME=SparkNest
